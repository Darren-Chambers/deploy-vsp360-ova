# =======================================================
# Vault — ansible_vault_vars/ansible_vault.yml
# =======================================================
# Contains all secrets for the VSP360 deployment project.
#
# To encrypt after filling in values:
#   ansible-vault encrypt ansible_vault_vars/ansible_vault.yml
#
# To edit an encrypted vault:
#   ansible-vault edit ansible_vault_vars/ansible_vault.yml
#
# To decrypt:
#   ansible-vault decrypt ansible_vault_vars/ansible_vault.yml
# =======================================================

# -------------------------------------------------------
# AAP credentials
# -------------------------------------------------------
aap_user: "admin"
aap_pass: "your-aap-password"

# -------------------------------------------------------
# vCenter credentials
# -------------------------------------------------------
vcenter_username: "administrator@vsphere.local"
vcenter_password: "your-vcenter-password"

# -------------------------------------------------------
# VSP360 credentials
# -------------------------------------------------------
vsp360_root_password: "ChangeMe.vsp360"
